// bmp390 — Bosch's BMP390 digital pressure sensor, on its I2C or its SPI
// bus, as devices-nv's `Barometer`, `Thermometer` and `Identifiable`.
//
// The facts below are from Bosch Sensortec's "BMP390 Datasheet",
// document number BST-BMP390-DS002-07, revision 1.7, March 2021; the
// sections and tables named are that sheet's.  Where the sheet and the
// drivers read for this one disagree, the site says which was taken.
//
// The register map (§ 4.2, Table 25), as this driver uses it:
//
//   0x00  CHIP_ID      0x60 (the BMP388 answers 0x50)
//   0x01  REV_ID
//   0x02  ERR_REG      fatal_err (0), cmd_err (1), conf_err (2); clear on read
//   0x03  STATUS       cmd_rdy (4), drdy_press (5), drdy_temp (6)
//   0x04  DATA_0 to 0x06 DATA_2    pressure, 24 bits, XLSB first
//   0x07  DATA_3 to 0x09 DATA_5    temperature, 24 bits, XLSB first
//   0x10  EVENT        por_detected (0); clear on read
//   0x11  INT_STATUS   drdy (3); clear on read
//   0x19  INT_CTRL     int_od (0), int_level (1), int_latch (2),
//                      drdy_en (6)
//   0x1B  PWR_CTRL     press_en (0), temp_en (1), mode (5:4)
//   0x1C  OSR          osr_p (2:0), osr_t (5:3)
//   0x1D  ODR          odr_sel (4:0)
//   0x1F  CONFIG       iir_filter (3:1)
//   0x31  to 0x45      the 21 bytes of trimming coefficients (Table 24)
//   0x7E  CMD          0xB0 fifo_flush, 0xB6 softreset
//
// The modes (§ 3.3): mode 00 is sleep, 01 and 10 are forced, 11 is
// normal.  A forced measurement runs once with the oversampling set and
// the part returns to sleep; the next one needs the mode written again.
// Normal mode repeats at the rate odr_sel gives.  A mode change during a
// measurement waits for the measurement to end.
//
// The compensation (§ 8.4 to 8.6).  The sheet gives its formulas as C in
// floating point.  The driver follows them in `Float`, binary64, with the
// operations in the same order, so a reading is what the sheet computes.
// The coefficients are 14 numbers read from 21 bytes (Table 24): T1, T2,
// P1, P2, P5, P6 and P9 are 16 bits, the others 8; T1, T2, P5 and P6 are
// unsigned and the rest signed.  Fix kept: Zephyr's bmp388 driver widens
// only some of them to the signed type, and a coefficient read as the
// wrong signedness gives a large error; the sign of every one is taken
// from Table 24.  Fix kept: the C of the Bosch API, from which Zephyr's
// integer algorithm is adapted, divides by 10 and multiplies by 10 in the
// pressure to avoid a 64-bit overflow and casts a signed intermediate to
// unsigned; binary64 needs neither.
//
// The conversion time (§ 3.9.2) is 234 us + 392 us + 2^osr_p * 2020 us +
// 163 us + 2^osr_t * 2020 us with both measurements on.  Table 23's
// typical column agrees with it except at ×8 / ×1, where it prints 18.69
// ms and the formula gives 18.97 ms; the formula is taken.  The maximum
// column is at most 18 % above the typical one, and `conversion_us`
// answers the formula plus 20 %.
//
// The output data rate in normal mode is 200 Hz divided by 2^odr_sel
// (Table 45).  Table 45 prints the prescaler for odr_sel 7 as 127 and
// the period as 640 ms, which is 128 times 5 ms; the driver takes 128.
// Fix kept: a combination whose period is shorter than the conversion
// sets conf_err in ERR_REG (§ 4.3.3); `odr_min_sel` answers the smallest
// odr_sel that is safe for an oversampling, and `normal_start` clamps to
// it and reads ERR_REG after.
//
// The two buses (§ 5).  On I2C the part answers at 0x76 (SDO low) or 0x77
// (SDO high), and the register address advances after each byte.  On SPI
// a transaction is a control byte, then data, inside one chip-select
// window: bit 7 of the control byte is RW (1 reads), bits 6 to 0 the
// register, and the address advances after each byte.  Fix kept: an SPI
// read sends one dummy byte after the control byte (§ 5.3.2) which an I2C
// read does not, so the first byte clocked in is not data; `spi_read_into`
// drops it.  The SPI mode is 0 or 3 (CPOL = CPHA), up to 10 MHz.
//
// The data-ready.  `begin` enables drdy_en on the INT pin, active high
// and push-pull, with the interrupt latched, so a slow reader does not
// lose the pulse; the line is lowered by reading INT_STATUS, which
// `irq_clear` does.  In non-latched mode the sheet de-asserts it after
// 2.5 ms (§ 3.7.2).
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/bosch/bmp388` and the BMP3 sensor API's reading of
// the sheet it is adapted from.  Each fix kept is named at its site.
//
// A bus enters through `Bmp390Port`, which a type that holds a bus
// implements: `Bmp390` for an I2C bus and `Bmp390Spi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over
// a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes, RegPort }
use dev_baro.{ Pascals, Barometer }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let CHIP_ID    = 0x00
let ERR_REG    = 0x02
let STATUS     = 0x03
let DATA_0     = 0x04
let EVENT      = 0x10
let INT_STATUS = 0x11
let INT_CTRL   = 0x19
let PWR_CTRL   = 0x1B
let OSR        = 0x1C
let ODR        = 0x1D
let CONFIG     = 0x1F
let CALIB_0    = 0x31
let CMD        = 0x7E

// CHIP_ID's value, and the commands.
let ID_BMP390     = 0x60
let CMD_SOFTRESET = 0xB6

// The SPI control byte's RW bit.
let SPI_READ = 0x80

// PWR_CTRL: both measurements on, and the modes.
let PWR_BOTH    = 0x03
let MODE_FORCED = 0x10
let MODE_NORMAL = 0x30
let MODE_MASK   = 0x30
// ERR_REG: the fatal and command errors, and the configuration error.
let ERR_FATAL_CMD = 0x03
let ERR_CONF      = 0x04
// STATUS: both data-ready flags.
let STATUS_DRDY = 0x60
// EVENT: the power-on reset bit.
let EVENT_POR = 0x01
// INT_CTRL: the data-ready on, latched, active high, push-pull.
let INT_DRDY_LATCHED = 0x46

// The oversampling `begin` sets: ×8 on pressure, ×1 on temperature,
// which Table 6 gives as the high-resolution setting; and 25 Hz.
let OSR_DEFAULT = 0x03
let ODR_DEFAULT = 3

// The largest oversampling code (Table 43) and odr_sel (Table 44), and
// the period of odr_sel 0.
let OSR_MAX       = 5
let IIR_MAX       = 7
let ODR_MAX       = 17
let ODR_PERIOD_US = 5000

// The raw value a measurement that was not made reads as.
let RAW_SKIPPED = 0x800000

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ   = 400000
let SPI_HZ   = 4000000
let SPI_MODE = 3

// The most polls of EVENT `start` makes for the reset to finish.
let RESET_POLLS = 2000

// The trimming coefficients of Table 24, converted as § 8.4 gives.
pub @value
struct Bmp390Cal
    t1: Float
    t2: Float
    t3: Float
    p1: Float
    p2: Float
    p3: Float
    p4: Float
    p5: Float
    p6: Float
    p7: Float
    p8: Float
    p9: Float
    p10: Float
    p11: Float

// One reading, compensated: the temperature in millidegrees Celsius and
// the pressure in millipascals.
pub @value
struct Bmp390Sample
    milli_c: Int
    milli_pa: Int

// A bus the part is on. `RegPort` is the register access, `read_regs` and
// `write_reg`, with the register reads and writes built on them; `setup`
// makes the bus and the pins ready and answers whether the wiring suits
// the bus; `irq_level` answers the level of the INT pin.
pub trait Bmp390Port: RegPort
    fn setup(self) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: the
// control byte with RW set, one dummy byte, then the data, of which the
// dummy is dropped.  Whether it ran, which is whether the wiring has a
// chip select.  `n` is at most 31, the room the transaction's buffer
// leaves for the dummy.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int, n: Int,
                                            var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((SPI_READ | (reg & 0x7F)) as u8)
    var raw: DevBytes = Vec.new()
    if not dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n + 1, var raw)
        dst.clear()
        return false
    dst.clear()
    for i in 1..raw.len()
        let _ = dst.push(raw[i])
    true

// Writes `v` to the register `reg` in one SPI transaction, RW clear:
// whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the INT pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub @deprecated(since = "0.2.0", replace_with = "dev_bus.wiring_i2c_setup")
fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    dev_bus.wiring_i2c_setup(bus, gpio, w, I2C_HZ)

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low before the bus is ready, then an output; the INT pin
// an input; the bus at 4 MHz in mode 3.  Answers whether the wiring has a
// chip select.
pub @deprecated(since = "0.2.0", replace_with = "dev_bus.wiring_spi_setup")
fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    dev_bus.wiring_spi_setup(bus, gpio, w, SPI_HZ, SPI_MODE)

// The level of the part's INT line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub @deprecated(since = "0.2.0", replace_with = "dev_bus.wiring_irq_level")
fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    dev_bus.wiring_irq_level(gpio, w)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub @deprecated(since = "0.2.0", replace_with = "RegPort.read_reg")
fn reg_read<P: Bmp390Port>(p: P, reg: Int) -> ?Int [hw]
    p.read_reg(reg)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  The mode bits of PWR_CTRL return to sleep after a
// forced measurement, so a mode is written with `write_reg`.
pub @deprecated(since = "0.2.0", replace_with = "RegPort.write_reg_verified")
fn reg_write<P: Bmp390Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    p.write_reg_verified(reg, v)

// ── Identity ─────────────────────────────────────────────────────────

// CHIP_ID and REV_ID as a `DeviceId`, or `None` when no part answers:
// the byte reads 0xFF on an SPI bus no part drives and 0x00 on one held
// low.
pub fn id_read<P: Bmp390Port>(p: P) -> ?DeviceId [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CHIP_ID, 2, var b)
        return None
    let who = b[0] as Int
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: Some(b[1] as Int) })

// ── Compensation ─────────────────────────────────────────────────────

// The unsigned 16-bit value at `i` of `b`, low byte first.
fn u16_at(b: DevBytes, i: Int) -> Int
    (b[i + 1] as Int << 8) | b[i] as Int

// The signed 16-bit value at `i` of `b`.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend(u16_at(b, i), 16)

// The signed 8-bit value at `i` of `b`.
fn s8_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend(b[i] as Int, 8)

// The coefficients of Table 24 from the 21 bytes at 0x31, converted as
// § 8.4 gives: T1 / 2^-8, T2 / 2^30, T3 / 2^48, (P1 - 2^14) / 2^20,
// (P2 - 2^14) / 2^29, P3 / 2^32, P4 / 2^37, P5 / 2^-3, P6 / 2^6,
// P7 / 2^8, P8 / 2^15, P9 / 2^48, P10 / 2^48 and P11 / 2^65.  T1, T2, P5
// and P6 are unsigned, the others signed.  Every divisor is a power of two,
// so the conversion is exact.
pub fn cal_of(b: DevBytes) -> Bmp390Cal
    Bmp390Cal {
        t1: u16_at(b, 0) as Float * 256.0,
        t2: u16_at(b, 2) as Float / 1073741824.0,
        t3: s8_at(b, 4) as Float / 281474976710656.0,
        p1: (s16_at(b, 5) - 16384) as Float / 1048576.0,
        p2: (s16_at(b, 7) - 16384) as Float / 536870912.0,
        p3: s8_at(b, 9) as Float / 4294967296.0,
        p4: s8_at(b, 10) as Float / 137438953472.0,
        p5: u16_at(b, 11) as Float * 8.0,
        p6: u16_at(b, 13) as Float / 64.0,
        p7: s8_at(b, 15) as Float / 256.0,
        p8: s8_at(b, 16) as Float / 32768.0,
        p9: s16_at(b, 17) as Float / 281474976710656.0,
        p10: s8_at(b, 19) as Float / 281474976710656.0,
        p11: s8_at(b, 20) as Float / 36893488147419103232.0 }

// The temperature in degrees Celsius for a raw 24-bit count (§ 8.5).  The
// result is also the t_lin that `pressure_pa` takes.
pub fn temperature_c(cal: Bmp390Cal, raw_t: Int) -> Float
    let d1 = raw_t as Float - cal.t1
    let d2 = d1 * cal.t2
    d2 + d1 * d1 * cal.t3

// The pressure in pascals for a raw 24-bit count and the `t_lin` of the
// same measurement (§ 8.6).
pub fn pressure_pa(cal: Bmp390Cal, raw_p: Int, t_lin: Float) -> Float
    let up = raw_p as Float
    let a1 = cal.p6 * t_lin
    let a2 = cal.p7 * (t_lin * t_lin)
    let a3 = cal.p8 * (t_lin * t_lin * t_lin)
    let out1 = cal.p5 + a1 + a2 + a3
    let b1 = cal.p2 * t_lin
    let b2 = cal.p3 * (t_lin * t_lin)
    let b3 = cal.p4 * (t_lin * t_lin * t_lin)
    let out2 = up * (cal.p1 + b1 + b2 + b3)
    let c1 = up * up
    let c2 = cal.p9 + cal.p10 * t_lin
    let c3 = c1 * c2
    let c4 = c3 + up * up * up * cal.p11
    out1 + out2 + c4

// `x` rounded to the nearest whole number, halves away from zero.
pub fn round_to_int(x: Float) -> Int
    if x < 0.0
        return (x - 0.5) as Int
    (x + 0.5) as Int

// The whole pascals of a pressure in millipascals, to the nearest.
pub fn pa_of_milli_pa(m: Int) -> Int
    if m < 0
        return (m - 500) / 1000
    (m + 500) / 1000

// The calibration from a part, or `None` when it did not answer.
pub fn cal_read<P: Bmp390Port>(p: P) -> ?Bmp390Cal [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CALIB_0, 21, var b)
        return None
    Some(cal_of(b))

// ── Samples ──────────────────────────────────────────────────────────

// The latest result, compensated with `cal`, in one burst of the six data
// registers so the two counts are from one measurement (§ 3.10).  `None`
// when the part did not answer or the pressure reads 0x800000, which is
// what a measurement that was not made leaves.
pub fn measure<P: Bmp390Port>(p: P, cal: Bmp390Cal) -> ?Bmp390Sample [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(DATA_0, 6, var b)
        return None
    let raw_p = (b[2] as Int << 16) | (b[1] as Int << 8) | b[0] as Int
    let raw_t = (b[5] as Int << 16) | (b[4] as Int << 8) | b[3] as Int
    if raw_p == RAW_SKIPPED
        return None
    let t = temperature_c(cal, raw_t)
    let pr = pressure_pa(cal, raw_p, t)
    Some(Bmp390Sample { milli_c: round_to_int(t * 1000.0), milli_pa: round_to_int(pr * 1000.0) })

// The latest result, with the calibration read first.  A program that
// reads often reads the calibration once with `cal_read` and calls
// `measure`.
pub fn sample_read<P: Bmp390Port>(p: P) -> ?Bmp390Sample [hw]
    let Some(cal) = cal_read(p) else return None
    measure(p, cal)

// Whether both a pressure and a temperature result are waiting: STATUS's
// drdy_press and drdy_temp, which reading the data registers clears.
pub fn data_ready<P: Bmp390Port>(p: P) -> Bool [hw]
    ((p.read_reg(STATUS) ?? 0) & STATUS_DRDY) == STATUS_DRDY

// Reads INT_STATUS, which lowers a latched INT pin, and answers it, or -1
// when the part did not answer.
pub fn irq_clear<P: Bmp390Port>(p: P) -> Int [hw]
    p.read_reg(INT_STATUS) ?? -1

// Reads ERR_REG, which clears it, and answers it, or -1 when the part
// did not answer.  Bit 0 is a fatal error, bit 1 a command error and
// bit 2 a configuration error.
pub fn err_read<P: Bmp390Port>(p: P) -> Int [hw]
    p.read_reg(ERR_REG) ?? -1

// The latest pressure, rounded to a pascal, with the calibration read
// first; `None` when there is no result.
pub fn baro_read_of<P: Bmp390Port>(p: P) -> ?Pascals [hw]
    let Some(s) = sample_read(p) else return None
    Some(Pascals { pa: pa_of_milli_pa(s.milli_pa) })

// The latest temperature in millidegrees, with the calibration read
// first; `None` when there is no result.
pub fn temp_read_of<P: Bmp390Port>(p: P) -> ?TempMilliC [hw]
    let Some(s) = sample_read(p) else return None
    Some(TempMilliC { milli_c: s.milli_c })

// ── Settings ─────────────────────────────────────────────────────────

// The time a forced measurement takes in microseconds for the OSR byte
// `osr`, both measurements on: § 3.9.2's formula plus 20 %, which covers
// Table 23's maximum column.  Oversampling codes above 5 count as 5.
pub fn conversion_us(osr: Int) -> Int
    let p = clamp_osr(osr & 7)
    let t = clamp_osr((osr >> 3) & 7)
    let typ = 234 + 392 + (1 << p) * 2020 + 163 + (1 << t) * 2020
    (typ * 6 + 4) / 5

// `n` held to the oversampling codes 0 to 5.
fn clamp_osr(n: Int) -> Int
    if n > OSR_MAX
        return OSR_MAX
    n

// The period of odr_sel `sel` in microseconds: 5 ms times 2^sel.  Table 45
// prints 127 for sel 7, and 128 is what it comes to.
pub fn odr_period_us(sel: Int) -> Int
    ODR_PERIOD_US << sel

// The smallest odr_sel whose period is at least the conversion time for
// the OSR byte `osr`.  A shorter period sets conf_err in normal mode.
pub fn odr_min_sel(osr: Int) -> Int
    let need = conversion_us(osr)
    var sel = 0
    for _i in 0..ODR_MAX
        if odr_period_us(sel) < need
            sel = sel + 1
    sel

// Sets the oversampling of pressure and temperature, each 0 to 5 for ×1
// to ×32: whether the part took it.  A code outside 0 to 5 is refused.
pub fn osr_write<P: Bmp390Port>(p: P, osr_p: Int, osr_t: Int) -> Bool [hw]
    if osr_p < 0 or osr_p > OSR_MAX or osr_t < 0 or osr_t > OSR_MAX
        return false
    p.write_reg_verified(OSR, (osr_t << 3) | osr_p)

// Sets the IIR filter coefficient code, 0 to 7 for a filter of 0, 1, 3,
// 7, 15, 31, 63 and 127 (Table 46): whether the part took it.  CONFIG's
// other bits are 0.
pub fn iir_write<P: Bmp390Port>(p: P, code: Int) -> Bool [hw]
    if code < 0 or code > IIR_MAX
        return false
    p.write_reg_verified(CONFIG, code << 1)

// Starts one forced measurement of both quantities and answers the time
// it takes in microseconds, to be waited before the result is read.  A
// part in normal mode converts by itself, so nothing is written and the
// answer is 0.  -1 when the part did not answer.
//
// Fix kept: PWR_CTRL is written with the mode bits and not read back,
// since the mode returns to sleep when the measurement ends.
pub fn convert_start<P: Bmp390Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PWR_CTRL, 2, var b)
        return -1
    if (b[0] as Int & MODE_MASK) == MODE_NORMAL
        return 0
    if not p.write_reg(PWR_CTRL, PWR_BOTH | MODE_FORCED)
        return -1
    conversion_us(b[1] as Int)

// Starts normal mode at odr_sel `sel`, held between the smallest safe one
// for the oversampling and 17: whether the part took it and reports no
// configuration error.
pub fn normal_start<P: Bmp390Port>(p: P, sel: Int) -> Bool [hw]
    let Some(osr) = p.read_reg(OSR) else return false
    var s = sel
    if s < odr_min_sel(osr)
        s = odr_min_sel(osr)
    if s > ODR_MAX
        s = ODR_MAX
    if not p.write_reg_verified(ODR, s)
        return false
    if not p.write_reg(PWR_CTRL, PWR_BOTH | MODE_NORMAL)
        return false
    (err_read(p) & (ERR_FATAL_CMD | ERR_CONF)) == 0

// Puts the part in sleep with both measurements enabled: whether the part
// took it.
pub fn sleep_mode<P: Bmp390Port>(p: P) -> Bool [hw]
    p.write_reg_verified(PWR_CTRL, PWR_BOTH)

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready; CHIP_ID checked; the part reset
// with the soft-reset command, which finishes when EVENT's por_detected
// reads 1; the error register cleared and checked; then sleep with both
// measurements on, ×8 pressure and ×1 temperature oversampling, the IIR
// filter off, 25 Hz for normal mode, and the data-ready on the INT pin,
// latched and active high; and the calibration read once to prove it
// readable.  Answers whether the part answered as a BMP390 and took every
// setting.  Measurements start with `convert_start`.
pub fn start<P: Bmp390Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if p.read_reg(CHIP_ID) != Some(ID_BMP390)
        return false
    let _stale = p.read_reg(EVENT)
    if not p.write_reg(CMD, CMD_SOFTRESET)
        return false
    var done = false
    for _i in 0..RESET_POLLS
        if ((p.read_reg(EVENT) ?? 0) & EVENT_POR) != 0
            done = true
            break
    if not done
        return false
    if (err_read(p) & ERR_FATAL_CMD) != 0
        return false
    let ok = p.write_reg_verified(PWR_CTRL, PWR_BOTH) and p.write_reg_verified(OSR, OSR_DEFAULT) and p.write_reg_verified(ODR, ODR_DEFAULT) and p.write_reg_verified(CONFIG, 0) and p.write_reg_verified(INT_CTRL, INT_DRDY_LATCHED)
    ok and cal_read(p) != None

// ── The part on an I2C bus ───────────────────────────────────────────

// A BMP390 on a board's I2C bus at the address `w.addr`, 0x76 or 0x77,
// with the board's GPIO for the INT line.
pub @value
struct Bmp390
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl RegPort for Bmp390
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

impl Bmp390Port for Bmp390
    fn setup(self) -> Bool [hw]
        dev_bus.wiring_i2c_setup(self.bus, self.pins, self.w, I2C_HZ)

    fn irq_level(self) -> Int [hw]
        dev_bus.wiring_irq_level(self.pins, self.w)

impl Bmp390
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Bmp390
        Bmp390 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        self.read_reg(r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        self.write_reg_verified(r, v)

    // The trimming coefficients, to be kept by a program that reads
    // often and passed to `sample_with`.
    fn calibration(self) -> ?Bmp390Cal [hw]
        cal_read(self)

    // The latest result compensated with `cal`: the temperature in
    // millidegrees and the pressure in millipascals.
    fn sample_with(self, cal: Bmp390Cal) -> ?Bmp390Sample [hw]
        measure(self, cal)

    // The latest result, with the calibration read first.
    fn sample(self) -> ?Bmp390Sample [hw]
        sample_read(self)

    // Whether a new pressure and a new temperature are waiting.
    fn ready(self) -> Bool [hw]
        data_ready(self)

    // Reads INT_STATUS, which lowers a latched INT pin.
    fn clear_irq(self) -> Int [hw]
        irq_clear(self)

    // Reads ERR_REG, which clears it.
    fn errors(self) -> Int [hw]
        err_read(self)

    // Sets the oversampling of pressure and temperature, 0 to 5 each.
    fn set_oversampling(self, osr_p: Int, osr_t: Int) -> Bool [hw]
        osr_write(self, osr_p, osr_t)

    // Sets the IIR filter code, 0 to 7.
    fn set_iir(self, code: Int) -> Bool [hw]
        iir_write(self, code)

    // Starts normal mode at odr_sel `sel`.
    fn run_normal(self, sel: Int) -> Bool [hw]
        normal_start(self, sel)

    // Puts the part in sleep.
    fn sleep(self) -> Bool [hw]
        sleep_mode(self)

impl Barometer[hw] for Bmp390
    // Starts a forced measurement and answers the time it takes in
    // microseconds, 0 in normal mode, -1 when the part did not answer.
    fn baro_start(self) -> Int [hw]
        convert_start(self)

    // The latest pressure, rounded to a pascal.
    fn baro_read(self) -> ?Pascals [hw]
        baro_read_of(self)

impl Thermometer[hw] for Bmp390
    // The same forced measurement as `baro_start`: one conversion gives
    // both results.
    fn temp_start(self) -> Int [hw]
        convert_start(self)

    // The latest temperature in millidegrees.
    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Bmp390
    // CHIP_ID, 0x60, with REV_ID as `rev`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// A BMP390 on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the INT line.
